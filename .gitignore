# Backend (Flask at Root)
# =========================
# Environments
venv/
env/
.venv/

# Compiled object files
__pycache__/
*.py[cod]
*$py.class

# Flask & Configs
instance/
.env
.flaskenv

# =========================
# App Specific (Face ID & Camera)
# =========================
# Ignore temporary image streams/snapshots
temp_snapshot.jpg
temp_snapshot.jpeg
uploads/

# Ignore personal face data
my_database/*.jpg
my_database/*.jpeg
my_database/*.png

# DeepFace cache files
my_database/representations_*.pkl

# Python tooling / tests
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Flask/SQLite database files
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# VS Code, if you don't want to share editor settings
.vscode/

# More frontend env files
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local
frontend/.env.test.local

# Backend uploads inside app, if you later store them there
app/uploads/